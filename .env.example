# Use the SAME Supabase project as Melon. Never use a service-role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_KEY
# Production canonical URL. Local development supports http://localhost:3004.
APP_URL=https://YOUR_VERCEL_PROJECT.vercel.app
